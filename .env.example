# Copy this file to .env.local and fill in the three values.
# This file holds only the NAMES of the values, no secrets, so it is
# safe to commit. .env.local holds the real values; it stays on your
# machine and in Vercel's settings, and never goes to GitHub
# (.gitignore enforces this).

# Your personal site token, copied EXACTLY from the course platform's
# /register-site page. Your /api/health route echoes it so the course
# prober knows this site is yours.
SITE_TOKEN=gdaas-paste-yours-here

# From your Supabase project (Chapter 3, Step 5). Find both in the
# dashboard under Settings -> API Keys (the URL also appears in the
# project's Connect dialog). Use the "publishable" key, the one that is
# safe to expose; it may start with sb_publishable_ or eyJ depending on
# when your project was created. Either works.
# The NEXT_PUBLIC_ prefix is required; it's how Next.js exposes them.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here
